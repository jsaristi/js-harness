{
  "name": "js-harness",
  "version": "0.97.0",
  "license": "MIT",
  "description": "A small, evidence-first harness for AI-assisted development on Claude Code and Codex.",
  "type": "module",
  "bin": {
    "js-harness": "bin/js-harness.mjs"
  },
  "files": [
    "bin/",
    "!bin/**/*.test.mjs",
    "!bin/**/*.testkit.mjs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check": "node bin/check.mjs",
    "test": "node --test",
    "e2e": "node scripts/e2e.mjs",
    "release-proof": "node scripts/release-proof.mjs",
    "sandbox": "node scripts/sandbox.mjs",
    "practice": "node scripts/practice.mjs",
    "hooks": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsaristi/js-harness.git"
  }
}
