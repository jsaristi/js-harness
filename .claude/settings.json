{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const fs=require('fs'),path=require('path'),a=process.argv,s=a[1];let d=path.resolve(process.env.CLAUDE_PROJECT_DIR||'.'),f;for(;;){try{f=fs.realpathSync(path.join(d,s));break}catch{}const p=path.dirname(d);if(p===d)break;d=p}if(f){a[1]=f;import(require('url').pathToFileURL(f).href).catch(()=>{})}\" workshop/js-harness-workshop.mjs ticks --hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
