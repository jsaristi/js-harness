#!/bin/sh
# Refuses a push whose code commits no Codex review record covers: runs `check --push` for each
# ref being pushed. Git feeds one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>,
# and names the remote as $1; the check measures the push against that remote's default branch.
root=$(git rev-parse --show-toplevel)
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # Main is pushed only by the merge queue, which says so (odd/tasks/merge-queue.md, S9): main tested as a
  # candidate is main as pushed only when nothing else pushes it. A delete of main is refused with the rest.
  case "$remote_ref" in
    refs/heads/main)
      if [ "${JS_HARNESS_MERGE_QUEUE:-}" != 1 ]; then
        echo "pre-push: main is pushed only by js-harness merge-queue --land; push your branch, open its pull request, and let the queue land it." >&2
        status=1
        continue
      fi
      ;;
  esac
  # A delete pushes nothing (its local sha is all zeros), so there is nothing to review.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  # A version tag names its version to the check (--ref), which refuses the push when package.json at the tagged commit says another one.
  case "$remote_ref" in
    refs/tags/v*) ref_flag="--ref $remote_ref" ;;
    *) ref_flag= ;;
  esac
  # The check gets /dev/null: a child that inherits stdin would read the rest of the ref list.
  node "$root/bin/check.mjs" --push --remote "$1" --head "$local_sha" $ref_flag < /dev/null || status=1
done
exit $status
