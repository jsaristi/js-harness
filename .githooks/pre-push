#!/bin/sh
# Refuses a push whose code commits no Codex review record covers: runs `check --push` for each
# ref being pushed. Git feeds one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>,
# and names the remote as $1; the check measures the push against that remote's default branch.
root=$(git rev-parse --show-toplevel)
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # A delete pushes nothing (its local sha is all zeros), so there is nothing to review.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  # The check gets /dev/null: a child that inherits stdin would read the rest of the ref list.
  node "$root/bin/check.mjs" --push --remote "$1" --head "$local_sha" < /dev/null || status=1
done
exit $status
